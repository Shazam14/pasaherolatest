# Provisioned automatically when you run `vercel env pull .env.local`
# after linking the project and adding Neon Postgres via Vercel Marketplace.
DATABASE_URL=

# Maps use MapLibre GL + OpenFreeMap tiles — no API key required.
# If we ever swap to a keyed provider (MapTiler, Stadia), add NEXT_PUBLIC_* here.

# PayMongo (added in Phase 2 once business permits are in)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Semaphore SMS (PH)
SEMAPHORE_API_KEY=

# Password for /admin (HTTP Basic — any username, this as the password).
# If unset, /admin returns 503 rather than exposing submissions.
ADMIN_PASSWORD=
